# Generated build artifacts — Pages output regenerated every workflow
# run. Not tracked so local renders don't race with bot pushes.
# Carve-out: data/claude-summaries.json IS tracked (routine output,
# consumed by render-site.mjs + generate-audio.py).
data/*
!data/claude-summaries.json
node_modules/
audio-segments/
*.log
.tmp-*
.data-hash.tmp

# Pages output lives under docs/, but documentation folders inside
# docs/ (specs, plans, designs, etc.) ARE tracked. List the generated
# build outputs specifically instead of ignoring the whole docs/ tree.
docs/index.html
docs/digest.mp3
docs/digest-en.mp3
docs/digest-zh.mp3
docs/audio-cues.json
docs/audio-cues-en.json
docs/audio-cues-zh.json
docs/content-translations.json
docs/audio-segments/
docs/data/
docs/digests/

# GitNexus index + agent prompts (generated by `npx gitnexus analyze`).
# The .gitnexus/ index directory self-ignores via its own .gitignore;
# these top-level prompts are local-only too — the PreToolUse hook picks
# up the index from .gitnexus/ without needing in-repo agent markers.
AGENTS.md
CLAUDE.md
.claude/
